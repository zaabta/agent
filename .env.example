PORT=3220
DATABASE_URL=postgres://sitepilot:sitepilot@localhost:5444/sitepilot
# Local-development-only shared API key. Compatibility is disabled unless explicitly enabled below.
DEV_API_KEY=replace-with-a-long-random-value
ENABLE_DEV_API_KEY_AUTH=false
# Required for JWT access tokens; use at least 32 random bytes. Never commit the value.
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
# Development-only server-authoritative workspace ID. Never accept tenant ID from model or request body.
DEV_TENANT_ID=demo-workspace
# Owner scope for the explicitly enabled local development API key.
DEV_CONVERSATION_OWNER_ID=dev-shared-api-key
# Bounds request time and recent message context sent to Mastra.
AGENT_REQUEST_TIMEOUT_MS=180000
AGENT_HISTORY_MESSAGES=10
AGENT_HISTORY_MESSAGE_CHARS=3000
# Must already be installed on your local Ollama server. No automatic model downloads.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# TypeGraph-native post-retrieval reranking with the local Ollama chat model; optional and disabled by default.
TYPEGRAPH_RERANK=false
# TypeGraph native entity/fact extraction on ingestion using local Ollama; asynchronous through BullMQ; disabled until explicitly enabled.
TYPEGRAPH_GRAPH_EXTRACTION=false
TYPEGRAPH_MIN_SCORE=0.32
# Local-only default. Ollama must already have this chat model installed.
MASTRA_PROVIDER=ollama
MASTRA_MODEL=qwen3:8b
# Set true to use Qwen3 reasoning; false requests reasoning_effort=none through Ollama's OpenAI-compatible API.
OLLAMA_THINK=false
# OpenRouter is an opt-in provider. Do not send company/confidential documents to it.
OPENROUTER_API_KEY=
MAX_FILE_BYTES=10485760
MAX_BATCH_FILES=10
MAX_BATCH_BYTES=52428800
MAX_TENANT_DOCUMENTS=1000
UPLOAD_DIR=.sitepilot-data/uploads
REDIS_URL=redis://127.0.0.1:6391
DOCUMENT_QUEUE=sitepilot-document-processing
DOCUMENT_WORKER_CONCURRENCY=2
DOCUMENT_JOB_ATTEMPTS=3

# Must match the installed Ollama embedding model (nomic-embed-text is 768 dimensions)
OLLAMA_EMBED_DIMENSIONS=768
