PORT=3220
# Local default; the isolated Docker stack sets 0.0.0.0 inside its container.
API_HOST=127.0.0.1
DATABASE_URL=postgres://sitepilot:sitepilot@localhost:5444/sitepilot
# Required for JWT access tokens; use at least 32 random bytes. Never commit the value.
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
# Existing shared company workspace ID. Set this to the already populated workspace; never accept it from a request.
COMPANY_WORKSPACE_ID=replace-with-existing-company-workspace-id
# Deprecated local fallback used only when COMPANY_WORKSPACE_ID is unset outside production.
DEV_TENANT_ID=demo-workspace
# User ID authorized to manage installation-wide LLM settings and credentials.
INSTALLATION_OWNER_USER_ID=
# Optional local diagnostic actor; this is not an authentication credential.
DEV_CONVERSATION_OWNER_ID=diagnostic-user
# Provider, model, fallback, Ollama reasoning, and advanced runtime settings are managed in the LLM Settings page.
# Existing MASTRA_PROVIDER / MASTRA_MODEL / MASTRA_FALLBACK_MODEL / OLLAMA_THINK values remain supported for first-run bootstrap.
# Must already be installed on your local Ollama server. No automatic model downloads.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional local vision model for PNG/JPEG, drawing PDFs, and scanned PDF pages.
# Must already be installed in Ollama; no paid API fallback is used.
OLLAMA_VISION_MODEL=
OLLAMA_EMBED_MODEL=nomic-embed-text
# TypeGraph-native post-retrieval reranking with the local Ollama chat model; optional and disabled by default.
TYPEGRAPH_RERANK=false
# TypeGraph native entity/fact extraction on ingestion using local Ollama; asynchronous through BullMQ; disabled until explicitly enabled.
TYPEGRAPH_GRAPH_EXTRACTION=false
# Required for saving provider API keys from the LLM Settings page.
# 32 random bytes encoded as base64 (e.g. `openssl rand -base64 32`). Required to save encrypted API keys through the admin API.
LLM_CREDENTIALS_ENCRYPTION_KEY=
# Gemini 3.6 supports minimal/low/medium/high. Low reduces reasoning-token overhead; use medium/high for harder requests.
GEMINI_THINKING_LEVEL=low
# Optional environment fallbacks remain supported for existing installations: GEMINI_API_KEY, OPENROUTER_API_KEY, OPENAI_API_KEY.
# Advanced runtime values (request timeout/history limits/TypeGraph threshold) can be changed through the admin API.
MAX_FILE_BYTES=10485760
MAX_BATCH_FILES=10
MAX_BATCH_BYTES=52428800
MAX_TENANT_DOCUMENTS=1000
UPLOAD_DIR=.sitepilot-data/uploads
REDIS_URL=redis://127.0.0.1:6391
DOCUMENT_QUEUE=sitepilot-document-processing
DOCUMENT_WORKER_CONCURRENCY=2
DOCUMENT_JOB_ATTEMPTS=3

# Must match the installed Ollama embedding model (nomic-embed-text is 768 dimensions)
OLLAMA_EMBED_DIMENSIONS=768
SITEPILOT_AGENT_ORCHESTRATION=workflow
SITEPILOT_CHUNK_MAX_TOKENS=480
SITEPILOT_CHUNK_TARGET_TOKENS=360
SITEPILOT_CHUNK_MIN_TOKENS=80
SITEPILOT_CHUNK_OVERLAP_TOKENS=40

# Query language for retrieval: auto uses English with nomic-embed-text, otherwise the user language.
# Generation always keeps the original user language. Set original or english to override.
AGENT_RETRIEVAL_QUERY_LANGUAGE=auto
