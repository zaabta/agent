generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Application metadata only. TypeGraph owns its own storage tables and indexes.
model AppDocument {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id")
  filename   String
  fileType   String   @map("file_type")
  status     String   @default("processing")
  stage      String   @default("queued")
  progress   Int?
  jobId      String?  @unique @map("job_id")
  retryCount Int      @default(0) @map("retry_count")
  failureCode String? @map("failure_code")
  fileSize   BigInt?  @map("file_size")
  checksum   String?
  storageKey String?  @map("storage_key")
  activeVersionId String? @map("active_version_id") @db.Uuid
  cancelRequested Boolean @default(false) @map("cancel_requested")
  deleteRequested Boolean @default(false) @map("delete_requested")
  completedAt DateTime? @map("completed_at")
  structuredCells AppDocumentCell[]
  versions   AppDocumentVersion[]
  progressEvents DocumentProgressEvent[]
  errorCode  String?  @map("error_code")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@unique([tenantId, checksum])
  @@map("app_documents")
}

model AppDocumentVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  documentId         String   @db.Uuid @map("document_id")
  tenantId           String   @map("tenant_id")
  versionNumber      Int      @map("version_number")
  filename           String
  checksum           String?
  fileSize           BigInt   @map("file_size")
  mimeType           String   @map("mime_type")
  uploadedAt         DateTime @default(now()) @map("uploaded_at")
  uploadedBy         String?  @map("uploaded_by")
  status             String   @default("queued")
  indexedChunkCount  Int      @default(0) @map("indexed_chunk_count")
  chunkingStrategy   String?  @map("chunking_strategy")
  chunkerVersion     String?  @map("chunker_version")
  embeddingModel     String?  @map("embedding_model")
  embeddingDimensions Int?    @map("embedding_dimensions")
  storageKey         String?  @map("storage_key")
  jobId              String?  @unique @map("job_id")
  cancelRequested    Boolean  @default(false) @map("cancel_requested")
  publishRequested   Boolean  @default(false) @map("publish_requested")
  replacementReason  String?  @map("replacement_reason")
  indexGeneration    Int      @default(1) @map("index_generation")
  activeIndexGeneration Int?  @map("active_index_generation")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  document           AppDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@unique([documentId, checksum])
  @@index([tenantId, documentId, uploadedAt(sort: Desc)])
  @@map("app_document_versions")
}

// Durable stage transitions. Unit counts stay nullable when the underlying
// parser or TypeGraph SDK does not expose measurable incremental progress.
model DocumentProgressEvent {
  id             String      @id @default(uuid()) @db.Uuid
  documentId     String      @db.Uuid @map("document_id")
  tenantId       String      @map("tenant_id")
  jobId          String      @map("job_id")
  attempt        Int
  stage          String
  status         String
  startedAt      DateTime    @default(now()) @map("started_at")
  finishedAt     DateTime?   @map("finished_at")
  completedUnits Int?        @map("completed_units")
  totalUnits     Int?        @map("total_units")
  embeddingDurationMs Int?   @map("embedding_duration_ms")
  unit           String?
  failureCode    String?     @map("failure_code")
  document       AppDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, jobId, startedAt])
  @@index([documentId, attempt, startedAt])
  @@map("document_progress_events")
}

model AppDocumentCell {
  id          String      @id @default(uuid()) @db.Uuid
  documentId  String      @db.Uuid @map("document_id")
  versionId   String?     @db.Uuid @map("version_id")
  tenantId    String      @map("tenant_id")
  sheetName   String      @map("sheet_name")
  rowNumber   Int         @map("row_number")
  address     String
  columnName  String      @map("column_name")
  value       String      @db.Text
  valueType   String      @map("value_type")
  formula     String?     @db.Text
  document    AppDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionId, sheetName, address])
  @@index([tenantId, value])
  @@index([tenantId, documentId, versionId, sheetName, rowNumber])
  @@map("app_document_cells")
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id")
  ownerId   String    @map("owner_id")
  title     String?   @db.VarChar(120)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]
  context   ConversationContext?

  @@index([tenantId, ownerId, deletedAt, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  structuredSelection Json? @map("structured_selection")
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid @map("conversation_id")
  role           String
  content        String       @db.Text
  status         String       @default("completed")
  stage          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Small, durable conversation state. Evidence references are hints only; every
// document search still runs through the tenant/user-scoped TypeGraph tools.
model ConversationContext {
  conversationId String   @id @db.Uuid @map("conversation_id")
  tenantId       String   @map("tenant_id")
  ownerId        String   @map("owner_id")
  summary        String?  @db.Text
  evidenceRefs   Json     @default("[]") @map("evidence_refs")
  activeSelection Json?   @map("active_selection")
  entities       Json     @default("[]")
  decisions      Json     @default("[]")
  updatedAt      DateTime @updatedAt @map("updated_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerId, updatedAt(sort: Desc)])
  @@map("conversation_contexts")
}

// Explicit, user-managed facts/preferences only. Memory keys always include
// both tenant and user identities; records are soft-deleted for correction/audit.
model UserMemory {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  category  String
  content   String    @db.VarChar(500)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, userId, deletedAt, updatedAt(sort: Desc)])
  @@map("user_memories")
}

enum TenantRole {
  SUPER_ADMIN
  TENANT_ADMIN
  MEMBER
  READ_ONLY
}

model Tenant {
  id        String       @id
  name      String
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  members   Membership[]
  sessions  RefreshSession[]
  auditLogs AuditLog[]

  @@map("tenants")
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  username      String       @unique
  email         String?      @unique
  passwordHash  String       @map("password_hash")
  displayName   String?      @map("display_name")
  disabledAt    DateTime?    @map("disabled_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  memberships   Membership[]
  sessions      RefreshSession[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Membership {
  tenantId  String     @map("tenant_id")
  userId    String     @db.Uuid @map("user_id")
  role      TenantRole @default(MEMBER)
  createdAt DateTime   @default(now()) @map("created_at")
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @db.Uuid @map("family_id")
  tenantId  String    @map("tenant_id")
  userId    String    @db.Uuid @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, tenantId])
  @@map("refresh_sessions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id")
  userId    String?  @db.Uuid @map("user_id")
  action    String
  ipAddress String?  @map("ip_address")
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model RuntimeSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  @@map("runtime_settings")
}

model RegisteredModel {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  modelId     String   @map("model_id")
  displayName String?  @map("display_name")
  compatible Boolean  @default(true)
  enabled     Boolean  @default(true)
  source      String   @default("manual")
  available   Boolean  @default(true)
  local       Boolean  @default(false)
  validationStatus String @default("unknown") @map("validation_status")
  capabilities Json @default("{}")
  contextLength Int? @map("context_length")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@unique([provider, modelId])
  @@index([provider, available, compatible])
  @@map("registered_models")
}

model RuntimeSettingAudit {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  oldValue  String?  @map("old_value") @db.Text
  newValue  String   @map("new_value") @db.Text
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([key, createdAt(sort: Desc)])
  @@map("runtime_setting_audit")
}

model ProviderCredential {
  provider   String   @id
  ciphertext String   @db.Text
  iv         String
  authTag    String   @map("auth_tag")
  updatedBy  String?  @map("updated_by")
  updatedAt  DateTime @updatedAt @map("updated_at")
  @@map("provider_credentials")
}

model LlmUsage {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String
  configuredModelId String?  @map("configured_model_id")
  modelId           String   @map("model_id")
  inputTokens       Int?     @map("input_tokens")
  outputTokens      Int?     @map("output_tokens")
  totalTokens       Int?     @map("total_tokens")
  cachedTokens      Int?     @map("cached_tokens")
  reasoningTokens   Int?     @map("reasoning_tokens")
  usageSource       String?  @map("usage_source")
  accuracy          String   @default("unavailable")
  tenantId          String   @map("tenant_id")
  userId            String?  @map("user_id")
  conversationId    String?  @map("conversation_id") @db.Uuid
  logicalRequestId  String   @map("logical_request_id")
  invocationId      String   @unique @map("invocation_id")
  status            String
  latencyMs          Int?     @map("latency_ms")
  errorCategory     String?  @map("error_category")
  createdAt         DateTime @default(now()) @map("created_at")
  @@index([tenantId, createdAt])
  @@index([provider, modelId, createdAt])
  @@map("llm_usage")
}
